# ---------------------------------------------------------------------------
# AI Assisted Project Induction Platform — environment configuration
# Copy to `.env.local` and adjust. Every variable is prefixed with VITE_ and is
# therefore exposed to the browser bundle — never place secrets here.
# ---------------------------------------------------------------------------

# Application metadata
VITE_APP_NAME="AI Assisted Project Induction Platform"
VITE_APP_SHORT_NAME="Induction Platform"

# Adapter mode:
#   mock   -> the frontend runs entirely on the in-browser mock providers (default)
#   remote -> the frontend calls the real backend through services/api/client.ts
# Switching between the two requires NO page or component changes.
VITE_API_MODE=mock

# Base URL of the REST backend (only used when VITE_API_MODE=remote)
VITE_API_BASE_URL=https://localhost:8443/api/v1

# Request timeout in milliseconds (only used when VITE_API_MODE=remote)
VITE_API_TIMEOUT=30000

# Simulated network latency for the mock providers, in milliseconds
VITE_MOCK_LATENCY_MIN=250
VITE_MOCK_LATENCY_MAX=700

# Simulated failure rate for the mock providers (0 = never fail)
VITE_MOCK_FAILURE_RATE=0
